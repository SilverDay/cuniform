{
    "name": "silverday/cuniform",
    "description": "Markdown-based blog and page engine without a database",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": { "Cuniform\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Cuniform\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true
    }
}
