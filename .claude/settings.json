{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make stan)",
      "Bash(make lint)",
      "Bash(composer install *)",
      "Bash(php bin/cuniform build --dry-run)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./config/site.php)",
      "Read(./var/**)",
      "Read(./admin/**/*.local.php)",
      "Edit(./src/Vendor/**)",
      "Bash(rm -rf *)",
      "Bash(git push *)"
    ]
  }
}
